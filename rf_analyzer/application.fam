# Flipper Zero application manifest for the RF Analyzer (receive-only).
#
# This app performs Sub-GHz signal discovery, measurement and decoding using
# the Flipper Zero's built-in CC1101 radio. It never transmits: there is no
# TX code path anywhere in this application.
App(
    appid="rf_analyzer",
    name="RF Analyzer (RX)",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="rf_analyzer_app",
    requires=[
        "gui",
        "dialogs",
        "storage",
    ],
    # Sub-GHz device + protocol libraries shipped with the firmware SDK.
    fap_libs=["subghz"],
    stack_size=4 * 1024,
    fap_category="Sub-GHz",
    fap_icon="images/rf_analyzer_10px.png",
    fap_icon_assets="images",
    fap_version="1.0",
    fap_author="RF research tooling",
    fap_description="Receive-only Sub-GHz scanner, analyzer and decoder for authorized RF research. No transmit capability.",
)
